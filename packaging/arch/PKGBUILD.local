# Maintainer: William C. Canin
pkgname=argvus-control-panel
pkgver=0.1.0
pkgrel=1
pkgdesc="Quickshell control panel for the ARGVUS desktop."
arch=('any')
url="https://github.com/argvus/argvus-control-panel"
license=('GPL-3.0-only')
depends=(
  'argvus-session'
  'argvus-hyprland'
  'argvus-launcher'
  'argvus-accounts'
  'argvus-appearance'
  'argvus-display'
  'argvus-network'
  'argvus-notifications'
  'argvus-power'
  'argvus-control-center'
  'bash'
  'curl'
  'fastfetch'
  'gpu-screen-recorder'
  'hyprland'
  'jq'
  'libnotify'
  'libqalculate'
  'otf-font-awesome'
  'power-profiles-daemon'
  'procps-ng'
  'qt6-declarative'
  'quickshell'
  'wireplumber'
  'xdg-user-dirs'
)
optdepends=(
  'argvus: dispatcher used by control panel actions in a full desktop install'
  'argvus-widget-telemetry: optional widget telemetry panel controlled by the appearance card'
  'argvus-taskbar: Waybar top panel aligned with the control panel'
  'kdialog: avatar image picker from the user card'
  'nvidia-utils: NVIDIA GPU readout in the system card'
)
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=("SKIP")

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr install
}
